{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [".env"],
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "DATABASE_URL",
    "ORG_ID",
    "MODEL_WORK",
    "MODEL_FAST",
    "DRY_RUN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false
    },
    "test:live": {
      "cache": false,
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "TEST_DATABASE_URL",
        "EFFORT_WORK",
        "LLM_REFUSAL_FALLBACK"
      ]
    }
  }
}
