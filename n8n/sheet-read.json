{
  "name": "Intelligo - sheet-read",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sheet-read",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "sheet-read-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "intelligo-sheet-read"
    },
    {
      "parameters": {
        "jsCode": "// Verifies X-Intelligo-Signature (hex HMAC-SHA256 of the raw body).\n// n8n env: N8N_WEBHOOK_SECRET, NODE_FUNCTION_ALLOW_BUILTIN=crypto, N8N_BLOCK_ENV_ACCESS_IN_NODE=false\nconst crypto = require('crypto');\nconst item = $input.first();\nconst raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\nconst signature = String(item.json.headers['x-intelligo-signature'] || '');\nconst expected = crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(raw, 'utf8').digest('hex');\nconst valid = signature.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(signature, 'hex'), Buffer.from(expected, 'hex'));\nif (!valid) {\n  throw new Error('Signature tidak valid');\n}\nreturn [{ json: JSON.parse(raw) }];"
      },
      "id": "sr-verify",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.INTELLIGO_SPREADSHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.sheet }}",
          "mode": "name"
        },
        "options": {
          "range": "={{ $json.range || '' }}"
        }
      },
      "id": "sheet-read-sheets",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets Intelligo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Returns every row as { rows: [...] } (header row becomes keys).\nreturn [{ json: { rows: $input.all().map((item) => item.json) } }];"
      },
      "id": "sr-collect",
      "name": "Collect rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "sr-respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1040, 0]
    }
  ],
  "connections": {
