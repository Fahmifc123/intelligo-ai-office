{
  "name": "intelligo-ai-office",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@intelligo/web --filter=@intelligo/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:live": "turbo run test:live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed:gen": "pnpm --filter @intelligo/shared seed:gen",
    "db:test": "supabase test db",
    "n8n:mock": "pnpm --filter @intelligo/worker mock:n8n"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.27",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
