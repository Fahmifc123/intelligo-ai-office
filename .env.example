# web + worker
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# untuk pg-boss (default supabase lokal)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# single-tenant v1
ORG_ID=00000000-0000-0000-0000-000000000001

# worker
ANTHROPIC_API_KEY=
MODEL_WORK=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
DRY_RUN=true
USD_TO_IDR=16000
MAX_STEPS=8

# test (pnpm test): admin URL used to create throwaway databases for worker integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# worker tuning (optional)
# LLM_MODE=scripted mengganti model dengan respons tetap (e2e / demo offline). Jangan dipakai di produksi.
LLM_MODE=live
IDLE_TICK_ENABLED=true
HEALTH_PORT=8787
LOG_LEVEL=info

# e2e (optional): pakai Chromium yang sudah terpasang alih-alih unduhan Playwright
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium

# LLM tuning (optional)
EFFORT_WORK=medium
LLM_REFUSAL_FALLBACK=true
# MODEL_PRICING_JSON={"claude-sonnet-5-5":{"input":2,"output":10,"cacheRead":0.2,"cacheWrite":2.5}}
TASK_TIMEOUT_MS=300000
